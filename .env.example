# Copiar a .env (NO subir .env). Ver backend/config/settings.py.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://fyag:fyag@localhost:5432/fyag

# Autenticación falsa para desarrollo (cabecera X-Dev-Role). Solo con DJANGO_DEBUG=true.
DEV_AUTH=true

# Auditoría: log (sin Mongo) | mongo
AUDIT_BACKEND=log
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fyag

# Clave de los usuarios de demostración (seed_demo)
SEED_PASSWORD=demo-cambiar-123
