# Copiar a .env.local (no se sube). Variables VITE_*.
VITE_API_BASE_URL=/api/v1

# Rol de desarrollo: se envía como cabecera X-Dev-Role al backend con DEV_AUTH=true.
# Valores: GERENCIA | ADMINISTRATIVO | SUPERVISOR | TECNICO (vacío = usar login)
VITE_DEV_ROLE=

# Datos simulados (MSW) por feature. true = usa mocks, false = usa la API real.
# Cada dueño pone su feature en false cuando su backend esté listo (hitos H1 a H3).
VITE_USE_MOCKS_AUTH=true
VITE_USE_MOCKS_USUARIOS=true
VITE_USE_MOCKS_TECNICO=true
VITE_USE_MOCKS_DASHBOARD=true
VITE_USE_MOCKS_REPORTES=true
VITE_USE_MOCKS_CLIENTES=true
VITE_USE_MOCKS_PRESUPUESTOS=true
VITE_USE_MOCKS_OBRAS=true
VITE_USE_MOCKS_COBRANZAS=true
